{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": false,
    "noEmitOnError": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "adapters/dsh/*.ts", "scripts/*.ts"],
  "exclude": ["node_modules", "dist"]
}
