{
  "name": "@solstice621/sandbox-runtime",
  "version": "0.4.0",
  "description": "Typed command sandbox runtime with macOS Seatbelt and Linux Bubblewrap backends",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "bin": {
    "sandbox-runner": "./bin/sandbox-runner"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./policy": {
      "types": "./dist/src/policy.d.ts",
      "import": "./dist/src/policy.js"
    },
    "./dsh": {
      "types": "./dist/adapters/dsh/plugin.d.ts",
      "import": "./dist/adapters/dsh/plugin.js"
    },
    "./client": {
      "types": "./dist/src/client.d.ts",
      "import": "./dist/src/client.js"
    },
    "./dsh/plugin": {
      "types": "./dist/adapters/dsh/entry.d.ts",
      "import": "./dist/adapters/dsh/entry.js"
    },
    "./opencode": {
      "types": "./dist/adapters/opencode/entry.d.ts",
      "import": "./dist/adapters/opencode/entry.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "acceptance": "python3 tests/acceptance.py --runner \"$PWD/bin/sandbox-runner\" --node \"$(node -p 'process.execPath')\" --report test-results/ts-local-acceptance.json",
    "benchmark": "python3 tests/benchmark.py --runner \"$PWD/bin/sandbox-runner\" --node \"$(node -p 'process.execPath')\" --report test-results/ts-local-benchmark.json",
    "postinstall": "node dist/scripts/bind-launchers.js"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.14",
    "@types/json-schema": "7.0.15",
    "@types/node": "24.0.0",
    "typescript": "5.9.3"
  },
  "files": [
    "dist/src/",
    "dist/adapters/",
    "dist/scripts/bind-launchers.*",
    "bin/",
    "scripts/launcher.sh",
    "scripts/opencode-shell.sh",
    "README.md",
    "NOTICE.md"
  ]
}
